# ======================================================================
# AgentLimit configuration. deploy/install_vultr.sh copies this to
# backend/.env and generates ACCESS_TOKEN for you.
# ======================================================================

# --- Access control (REQUIRED for any public deployment) ---
# Every session/evidence API needs this token (Bearer header or login cookie).
# Empty + AUTH_DISABLED=false  => APIs refuse to run (fail-closed).
ACCESS_TOKEN=
AUTH_DISABLED=false
# Set true once HTTPS is configured (the installer does this when DOMAIN is set)
COOKIE_SECURE=false
# Comma-separated extra origins allowed to call the API. Empty = same-origin only.
ALLOWED_ORIGINS=

# --- Spend / abuse limits across ALL sessions ---
MAX_CONCURRENT_SESSIONS=2
MAX_SESSIONS_PER_HOUR=20
MAX_TOKENS_PER_DAY=2000000

# --- Vultr Serverless Inference (required) ---
VULTR_INFERENCE_KEY=your_key_here
VULTR_INFERENCE_BASE=https://api.vultrinference.com/v1
# Model IDs exactly as GET /v1/models lists them (shown at /health once logged in).
VULTR_MODEL_DEFAULT=glm-5.2
# A genuinely CHEAPER model for THROTTLE. Leave empty if you don't have one:
# THROTTLE is then reported as CPU throttling only (no downgrade is claimed).
VULTR_MODEL_CHEAP=
# Per-model prices for ESTIMATED cost, USD per 1M tokens [input, output]
# PRICING_OVERRIDES={"glm-5.2": [0.55, 2.75]}

# --- Sandbox ---
MICROSANDBOX_IMAGE=python:3.11-slim
MICROSANDBOX_CPUS=1
# Agent code runs as this unprivileged user inside the guest ("" = root)
SANDBOX_EXEC_USER=nobody
# Memory budget = host-accounted microVM memory; guest RAM = budget - this
VMM_MEMORY_HEADROOM_MB=192
ALLOW_DOCKER_FALLBACK=false
REQUIRE_CONTAINMENT_PROBE=true

# --- Governor / evidence ---
AGENTLIMIT_WORKSPACE=workspace
CGROUP_ROOT=/sys/fs/cgroup/agentlimit
LEDGER_DIR=/var/lib/agentlimit/ledger
SIGNER_KEY_PATH=/var/lib/agentlimit/keys/signer.ed25519
POLL_INTERVAL_MS=500
PAUSE_TIMEOUT_S=120
INFLIGHT_DRAIN_S=15
FRONTEND_DIST=frontend/dist
